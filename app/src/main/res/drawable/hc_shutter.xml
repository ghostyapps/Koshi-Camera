<?xml version="1.0" encoding="utf-8"?>
<!-- Thin white ring, solid disc; the disc turns red while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="1.5dp" android:color="@color/hc_white" /></shape></item>
            <item android:inset="9dp"><shape android:shape="oval"><solid android:color="@color/hc_red" /></shape></item>
        </layer-list>
    </item>
    <item android:state_enabled="false">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="1.5dp" android:color="@color/hc_grey_dim" /></shape></item>
            <item android:inset="7dp"><shape android:shape="oval"><solid android:color="@color/hc_grey_dim" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="1.5dp" android:color="@color/hc_white" /></shape></item>
            <item android:inset="7dp"><shape android:shape="oval"><solid android:color="@color/hc_white" /></shape></item>
        </layer-list>
    </item>
</selector>
