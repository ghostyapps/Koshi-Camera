<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HeyCam" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/hc_black</item>
        <item name="android:statusBarColor">@color/hc_black</item>
        <item name="android:navigationBarColor">@color/hc_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">@font/barlow</item>
        <item name="fontFamily">@font/barlow</item>
        <item name="android:textColor">@color/hc_white</item>
        <item name="colorPrimary">@color/hc_white</item>
        <item name="colorAccent">@color/hc_red</item>
        <item name="colorSecondary">@color/hc_red</item>
        <item name="android:colorBackground">@color/hc_black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="HC" />

    <!-- Small uppercase label: S · ISO · EV, section headers. -->
    <style name="HC.Caps">
        <item name="android:fontFamily">@font/barlow_medium</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/hc_grey</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="HC.Strip">
        <item name="android:fontFamily">@font/barlow_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/hc_grey_dim</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="HC.Value">
        <item name="android:fontFamily">@font/barlow_light</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">@color/hc_white</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
