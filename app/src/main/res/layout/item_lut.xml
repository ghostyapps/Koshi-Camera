<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/view_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/hc_line_faint" />

    <LinearLayout
        android:id="@+id/item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/hc_row"
        android:orientation="horizontal"
        android:paddingStart="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="15dp"
            android:paddingBottom="14dp">
            <TextView
                android:id="@+id/txt_lut_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/barlow_light"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/hc_white"
                android:textSize="18sp" />
            <View
                android:id="@+id/view_selected_line"
                android:layout_width="120dp"
                android:layout_height="1.5dp"
                android:layout_marginTop="7dp"
                android:background="@color/hc_red"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_delete_lut"
            style="@style/HC.Caps"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="top|end"
            android:paddingStart="20dp"
            android:paddingTop="19dp"
            android:paddingEnd="24dp"
            android:text="Delete"
            android:textColor="@color/hc_grey_dim" />
    </LinearLayout>
</LinearLayout>
